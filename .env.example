# ============================================================
# EXEMPLO de variáveis de ambiente — Multi-Strategy Trading Bot
# ------------------------------------------------------------
# 1. Copie este arquivo para ".env"  (cp .env.example .env)
# 2. Preencha os valores reais APENAS no arquivo .env
# 3. NUNCA faça commit do .env — ele já está no .gitignore
# 4. Comece SEMPRE em paper trading / testnet
# ============================================================

# ---- Alpaca (ações e ETFs dos EUA) ----
# Gere as chaves em https://app.alpaca.markets no modo PAPER
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Mantenha "true" para operar apenas em conta simulada
ALPACA_PAPER_TRADE=true

# ---- Binance Spot Testnet (conectores CCXT/MCP e CLI Rust Fase 5) ----
# Gere as chaves somente em https://testnet.binance.vision
# Desative saque e use permissões mínimas; nunca use chave de produção.
# O binário Rust NÃO carrega .env automaticamente: exporte estas variáveis no processo.
BINANCE_API_KEY=
BINANCE_SECRET=
# As duas opções abaixo se aplicam aos conectores CCXT/MCP existentes; a CLI Rust ignora-as
# e fixa o host Binance Spot Testnet diretamente no código.
DEFAULT_EXCHANGE=binance
# "true" = modo sandbox/testnet para CCXT/MCP
SANDBOX=true

# ---- Polymarket ----
# polymarket-watch usa somente APIs públicas Gamma/CLOB/Data e WebSocket.
# Não lê nem aceita chave de carteira, signer, API secret ou credencial Polymarket.

# ---- Dashboard local autenticado e adaptador IA (opt-in) ----
# Use pelo menos 32 caracteres aleatórios; exemplo: openssl rand -hex 32
ODE_DASHBOARD_TOKEN=
# Necessário somente com --enable-ai-advisory; nunca envie carteira ou ordens ao provedor.
ODE_MODEL_API_KEY=
ODE_MODEL_BASE_URL=https://api.openai.com/v1
ODE_MODEL_NAME=gpt-4o-mini

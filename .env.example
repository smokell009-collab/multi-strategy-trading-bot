# ============================================================
# EXEMPLO de variáveis de ambiente — Multi-Strategy Trading Bot
# ------------------------------------------------------------
# 1. Copie este arquivo para ".env"  (cp .env.example .env)
# 2. Preencha os valores reais APENAS no arquivo .env
# 3. NUNCA faça commit do .env — ele já está no .gitignore
# 4. Comece SEMPRE em paper trading / testnet
# ============================================================

# ---- Alpaca (ações e ETFs dos EUA) ----
# Gere as chaves em https://app.alpaca.markets no modo PAPER
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Mantenha "true" para operar apenas em conta simulada
ALPACA_PAPER_TRADE=true

# ---- Binance Testnet (cripto via CCXT) ----
# Gere as chaves em https://testnet.binance.vision
# Desative a permissão de saque e, se possível, restrinja por IP
BINANCE_API_KEY=
BINANCE_SECRET=
DEFAULT_EXCHANGE=binance
# "true" = modo sandbox/testnet
SANDBOX=true

# ---- Polymarket (opcional — comece somente leitura) ----
# Use uma carteira DEDICADA com saldo mínimo, nunca a principal.
# Só preencha quando for operar de fato e após revisar o código do MCP.
POLYMARKET_PRIVATE_KEY=

# ---- Dashboard local autenticado e adaptador IA (opt-in) ----
# Use pelo menos 32 caracteres aleatórios; exemplo: openssl rand -hex 32
ODE_DASHBOARD_TOKEN=
# Necessário somente com --enable-ai-advisory; nunca envie carteira ou ordens ao provedor.
ODE_MODEL_API_KEY=
ODE_MODEL_BASE_URL=https://api.openai.com/v1
ODE_MODEL_NAME=gpt-4o-mini
